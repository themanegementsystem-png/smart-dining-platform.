<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Royal Spice – QR Dining</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;700&display=swap">
<style>
:root{--bg:#0a0908;--s1:#14110d;--s2:#1c1812;--gold:#d4af37;--gold2:#f0d68a;--tx:#f4eee3;--mu:#9c917f;--ln:#ffffff14;--red:#e0584a;--grn:#4fb477;--amb:#e8a23a;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
body{background:var(--bg);color:var(--tx);font:400 14px/1.5 Inter,system-ui,Arial,sans-serif;min-height:100vh}
h1,h2,h3,.serif{font-family:"Playfair Display",Georgia,serif;font-weight:700}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
input,select,textarea{width:100%;background:#0f0d0a;color:var(--tx);border:1px solid #ffffff22;border-radius:12px;padding:10px 12px;font:inherit;margin:4px 0}
input:focus,select:focus,textarea:focus{outline:0;border-color:var(--gold)}
small,.mu{color:var(--mu)}
.wrap{max-width:1100px;margin:auto;padding:0 16px 110px}
.btn{background:linear-gradient(135deg,var(--gold),var(--gold2));color:#1a1305;font-weight:700;padding:11px 20px;border-radius:12px;transition:.2s}
.btn:hover{filter:brightness(1.08);transform:translateY(-1px)}
.btn.o{background:none;border:1px solid var(--gold);color:var(--gold2)}
.btn.d{background:#3a1713;color:#ff9a8b}
.btn.sm{padding:7px 12px;font-size:12px;border-radius:10px}
.btn.w{width:100%;margin-top:10px}
.btn[disabled]{opacity:.4;pointer-events:none}
.chip{border:1px solid #ffffff22;background:var(--s1);border-radius:99px;padding:7px 14px;font-size:13px;white-space:nowrap;transition:.2s}
.chip.on{border-color:var(--gold);color:var(--gold2);background:#2a2110}
.card{background:var(--s1);border:1px solid var(--ln);border-radius:18px;padding:16px}
.glass{background:rgba(28,24,18,.72);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid #d4af3733}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.scroll{display:flex;gap:8px;overflow-x:auto;padding:4px 0 10px}
.mono{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;border:1.5px solid var(--gold);color:var(--gold2);font:700 20px "Playfair Display",Georgia,serif;flex:none}
.hero{text-align:center;padding:34px 16px 18px;background:radial-gradient(ellipse at 50% 0,#3a2c1055,transparent 70%)}
.hero .mono{margin:0 auto 10px;width:54px;height:54px;font-size:28px}
.hero h1{font-size:clamp(30px,8vw,46px);letter-spacing:4px;background:linear-gradient(90deg,var(--gold),var(--gold2),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{letter-spacing:5px;font-size:11px;text-transform:uppercase;color:var(--mu);margin:2px 0 14px}
.pill{display:inline-block;border:1px solid var(--gold);color:var(--gold2);border-radius:99px;padding:6px 16px;font-size:13px}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(310px,1fr))}
.sec{font:700 20px "Playfair Display",Georgia,serif;color:var(--gold2);margin:22px 0 12px}
.dish{display:flex;gap:14px;padding:14px;transition:.25s;animation:in .4s both}
.dish:hover{border-color:#d4af3766;transform:translateY(-2px)}
.dish.off{opacity:.5}
.plate{position:relative;flex:none;width:92px;height:92px;border-radius:50%;display:grid;place-items:center;font-size:46px;background:#241e15;border:1.5px solid var(--gold);overflow:hidden}
.up{position:relative;overflow:hidden;display:inline-block;cursor:pointer}.up input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;margin:0;padding:0;border:0;font-size:0}
.plate img{border-radius:50%}
.em{display:block}

.pick{flex:none;width:130px;text-align:center;cursor:pointer;display:flex;flex-direction:column;gap:4px;align-items:center}.pick .plate{width:84px;height:84px;font-size:40px}.pick .plate img{width:100%;height:100%;object-fit:cover}
.fl{display:flex;justify-content:center;gap:14px;margin-top:14px;font-size:34px}.fl span{animation:bob 3s ease-in-out infinite;filter:drop-shadow(0 8px 6px #000a)}
@keyframes bob{50%{transform:translateY(-8px)}}@keyframes steam{0%{opacity:0;transform:translateY(8px) scaleX(1)}40%{opacity:.8}100%{opacity:0;transform:translateY(-16px) scaleX(1.8)}}@keyframes fall{to{transform:translateY(110vh) rotate(360deg);opacity:.2}}
.plate img{width:100%;height:100%;object-fit:cover}
.dish .in{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
.nm{font-weight:600;font-size:15px;display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.vg{width:14px;height:14px;border:2px solid var(--grn);border-radius:3px;display:inline-grid;place-items:center;flex:none}
.vg::after{content:"";width:6px;height:6px;border-radius:50%;background:var(--grn)}.vg.nv{border-color:var(--red)}.vg.nv::after{background:var(--red)}
.tg{font-size:10px;background:#3a2b10;color:var(--gold2);padding:2px 8px;border-radius:99px}
.ds{font-size:12px;color:var(--mu);flex:1}
.pr{font-weight:700;color:var(--gold2);font-size:17px}
.qty{display:flex;align-items:center;gap:10px;background:#2a2110;border-radius:10px;padding:2px 4px}
.qty button{width:30px;height:30px;font-size:18px;color:var(--gold2)}
.bar{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));max-width:620px;margin:auto;z-index:30}
.bar .btn{width:100%;display:flex;justify-content:space-between;padding:15px 20px;box-shadow:0 12px 30px #000c}
.md{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.75);display:none;align-items:flex-end;justify-content:center}
.md.show{display:flex}
.mp{background:var(--s1);border-top:1px solid var(--gold);border-radius:24px 24px 0 0;width:100%;max-width:640px;max-height:92vh;overflow:auto;padding:18px 18px calc(22px + env(safe-area-inset-bottom,0px));animation:up .3s}
@media(min-width:700px){.md{align-items:center}.mp{border-radius:24px;border:1px solid var(--gold)}}
.mp h3{color:var(--gold2);font-size:21px}
.x{font-size:22px;color:var(--mu);padding:0 6px}
.ln{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px dashed #ffffff1c;font-size:14px}
.tot{display:flex;justify-content:space-between;color:var(--mu);padding:3px 0}.tot.g{color:var(--gold2);font:700 20px "Playfair Display",Georgia,serif;margin-top:6px}
.pm{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:1px solid #ffffff22;border-radius:12px;padding:11px;margin-top:8px}
.pm.on{border-color:var(--gold);background:#2a2110}
.note{font-size:12px;color:var(--amb);background:#2a1e0a;border:1px solid #e8a23a44;border-radius:10px;padding:8px 10px;margin-top:10px}
.bg{display:inline-block;font-size:11px;font-weight:600;padding:2px 10px;border-radius:99px;background:#ffffff14}
.bg.pending{background:#3a2b10;color:var(--amb)}.bg.accepted{background:#10283a;color:#7cc4f0}.bg.preparing{background:#3a2210;color:#ffa05c}.bg.ready{background:#10331c;color:#6fdc98}.bg.served{background:#1d3a24;color:#8be0a8}.bg.cancelled{background:#3a1713;color:#ff9a8b}.bg.demo{background:#2a2a2a;color:#bbb}
.steps{display:flex;margin:14px 0}
.st{flex:1;text-align:center;font-size:10px;color:var(--mu)}
.st i{display:grid;place-items:center;width:30px;height:30px;margin:0 auto 4px;border-radius:50%;border:2px solid #ffffff22;font-style:normal;font-size:12px}
.st.done{color:var(--grn)}.st.done i{background:var(--grn);border-color:var(--grn);color:#06210f}
.st.on{color:var(--gold2)}.st.on i{border-color:var(--gold);animation:pu 1.4s infinite}
.top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding:14px 16px;max-width:1100px;margin:auto}
.top .brand{display:flex;gap:10px;align-items:center}.top nav{display:flex;gap:6px;flex-wrap:wrap}
.kpis{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-bottom:14px}
.kpi small{text-transform:uppercase;letter-spacing:1px;font-size:11px}.kpi b{display:block;font:700 26px "Playfair Display",Georgia,serif;color:var(--gold2)}
.cols{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));align-items:start}
.col h4{font-size:12px;letter-spacing:2px;color:var(--mu);margin-bottom:10px;text-transform:uppercase}
.ord{border-left:4px solid var(--gold);margin-bottom:12px}.ord.pending{border-color:var(--amb)}.ord.preparing{border-color:#ff7a3c}.ord.ready{border-color:var(--grn)}
.ord .it{padding:3px 0;font-size:15px}
.nt{margin-top:8px;color:var(--gold2);font-size:13px}
.tabs{display:flex;gap:6px;overflow-x:auto;margin-bottom:14px;padding-bottom:4px}
.bars{display:flex;align-items:flex-end;gap:10px;height:140px;margin-top:6px}
.bars div{flex:1;text-align:center;font-size:11px;color:var(--mu);display:flex;flex-direction:column;justify-content:flex-end;height:100%}
.bars i{display:block;background:linear-gradient(180deg,var(--gold2),#7a5a1e);border-radius:6px 6px 0 0;min-height:3px;margin-bottom:4px}
.pb{height:7px;background:#ffffff14;border-radius:9px;overflow:hidden;margin-top:4px}.pb i{display:block;height:100%;background:linear-gradient(90deg,var(--gold),var(--gold2))}
.mrow{display:grid;grid-template-columns:48px 1fr 84px 44px 30px;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--ln)}
.mrow input{margin:0;padding:7px}
.tgl{width:40px;height:22px;border-radius:99px;background:#3a3027;position:relative;transition:.2s}.tgl.on{background:var(--grn)}
.tgl::after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.2s}.tgl.on::after{left:21px}
.stars span{font-size:28px;cursor:pointer;color:var(--gold)}
.qrs{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:12px}
.qr{background:#fff;color:#111;border-radius:14px;padding:10px;text-align:center;font-weight:700;font-size:13px}.qr div{display:flex;justify-content:center}.qr img,.qr canvas{max-width:100%;height:auto!important}
.inv{background:#fff;color:#111;border-radius:12px;padding:16px;font-size:13px}.inv table{width:100%;border-collapse:collapse}.inv td{padding:3px 0}.inv .r{text-align:right}.inv hr{margin:8px 0;border:0;border-top:1px dashed #999}
.toast{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));left:50%;transform:translate(-50%,-160%);background:var(--s2);border:1px solid var(--gold);padding:11px 18px;border-radius:14px;z-index:90;transition:.35s;max-width:92%;text-align:center}
.toast.show{transform:translate(-50%,0)}
.splash{position:fixed;inset:0;z-index:80;background:radial-gradient(ellipse at 50% 30%,#3a2c10,#0a0908 70%);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;gap:10px}
.splash h1{font-size:clamp(36px,11vw,60px);letter-spacing:5px;color:var(--gold2)}
.empty{text-align:center;color:var(--mu);padding:28px 0}
@keyframes in{from{opacity:0;transform:translateY(10px)}}
@keyframes up{from{opacity:0;transform:translateY(40px)}}
@keyframes pu{50%{box-shadow:0 0 0 7px #d4af3333}}
@media(max-width:520px){.grid{grid-template-columns:1fr}.mrow{grid-template-columns:44px 1fr 70px 40px 26px}}
@media print{body>*:not(#md){display:none!important}#md{position:static;background:#fff;display:block}.mp{border:0;max-height:none;background:#fff;padding:0}.mp .noprint{display:none!important}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="app"></div><div class="md" id="md"></div><div class="toast" id="ts"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
const $=s=>document.querySelector(s),esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const fmt=n=>"₹"+(Math.round(n*100)/100).toLocaleString("en-IN",{maximumFractionDigits:2});
const CATS=["Starters","Main Course","Biryani","Chinese","Beverages","Desserts"],KEY="royalspice_v4";
const STAT=["pending","accepted","preparing","ready","served"],SL={pending:"Pending",accepted:"Accepted",preparing:"Preparing",ready:"Ready",served:"Served",cancelled:"Cancelled"};
const NEXT={pending:"accepted",accepted:"preparing",preparing:"ready",ready:"served"},NL={pending:"Accept order",accepted:"Start preparing",preparing:"Mark ready",ready:"Mark served"};
const PMS={cash:["💵","Pay at table (cash / counter)"],upi:["📱","UPI (demo)"],card:["💳","Card (demo)"]};
const mk=(id,c,n,p,v,e,d,t)=>({id,c,n,p,v,e,d,t:t||"",on:true,img:""});
const DEF=()=>({cfg:{name:"Royal Spice",gst:5,gstin:"",tables:10,pins:{owner:"1234",kitchen:"0000",staff:"1111"}},
menu:[mk(1,"Starters","Paneer Tikka",249,1,"🍢","Tandoor-grilled malai paneer with mint chutney","Chef’s Special"),mk(2,"Starters","Chicken Seekh Kebab",299,0,"🍖","Smoky minced chicken with green chilli and kasuri methi"),mk(3,"Starters","Crispy Corn",189,1,"🌽","Golden fried corn tossed in chaat masala"),
mk(4,"Main Course","Butter Chicken",379,0,"🍛","Creamy makhani gravy with tandoori chicken","Best Seller"),mk(5,"Main Course","Paneer Butter Masala",329,1,"🥘","Rich tomato-cashew gravy with soft paneer"),mk(6,"Main Course","Dal Makhani",269,1,"🍲","Slow-cooked black lentils, butter and cream"),mk(7,"Main Course","Garlic Naan",69,1,"🫓","Tandoori bread with garlic and butter"),
mk(8,"Biryani","Hyderabadi Chicken Biryani",349,0,"🍚","Dum biryani with saffron basmati and raita","Signature"),mk(9,"Biryani","Veg Dum Biryani",289,1,"🍚","Seasonal vegetables, whole spices, saffron rice"),
mk(10,"Chinese","Veg Hakka Noodles",199,1,"🍜","Wok-tossed noodles with crunchy vegetables"),mk(11,"Chinese","Chilli Chicken",279,0,"🌶️","Crispy chicken in a spicy soy-garlic glaze"),mk(12,"Chinese","Veg Manchurian",209,1,"🥡","Vegetable dumplings in a tangy Manchurian sauce"),
mk(13,"Beverages","Mango Lassi",119,1,"🥭","Thick, chilled mango yoghurt drink"),mk(14,"Beverages","Masala Chai",59,1,"🍵","Cardamom and ginger tea"),mk(15,"Beverages","Fresh Lime Soda",89,1,"🍋","Sweet, salted or mixed"),
mk(16,"Desserts","Gulab Jamun",129,1,"🍡","Two warm dumplings in saffron syrup"),mk(17,"Desserts","Chocolate Brownie",179,1,"🍫","Warm brownie with vanilla ice cream")],
orders:[],staff:[{id:1,name:"Staff 1",tables:[1,2,3,4,5]},{id:2,name:"Staff 2",tables:[6,7,8,9,10]}],calls:[],seq:1000,nid:100});
function load(){try{const s=JSON.parse(localStorage.getItem(KEY));if(s&&s.menu){const d=DEF();return Object.assign(d,s,{cfg:Object.assign(d.cfg,s.cfg,{pins:Object.assign(d.cfg.pins,(s.cfg||{}).pins)})})}}catch(e){}return DEF()}
let S=load();
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){toast("Storage full – use smaller photos")}}
addEventListener("storage",e=>{if(e.key===KEY){const old=S;S=load();notify(old,S);render()}});
let view="cust",table=1,cart={},qs="",cat="All",veg=false,pm="cash",otab="overview",oflt="all",stf=1,mdFn=null,welcomed=true,auth={},arm=false;
const dk=t=>{const d=new Date(t);return d.getFullYear()+"-"+d.getMonth()+"-"+d.getDate()};
const calc=(items,r=S.cfg.gst)=>{const sub=items.reduce((a,i)=>a+i.p*i.q,0),gst=+(sub*r/100).toFixed(2);return{sub,gst,tot:+(sub+gst).toFixed(2)}};
const taxRows=(g,r)=>`<div class="tot"><span>CGST ${r/2}%</span><span>${fmt(g/2)}</span></div><div class="tot"><span>SGST ${r/2}%</span><span>${fmt(g/2)}</span></div>`;
const live=()=>S.orders.filter(o=>o.status!="cancelled"),mins=o=>Math.floor((Date.now()-o.ts)/6e4);
const item=id=>S.menu.find(i=>i.id==id),cnt=()=>Object.values(cart).reduce((a,b)=>a+b,0);
const cartItems=()=>Object.keys(cart).map(k=>{const i=item(k);return{id:i.id,n:i.n,p:i.p,q:cart[k]}});
const parseT=s=>String(s).split(",").flatMap(x=>{const m=x.trim().match(/^(\d+)\s*-\s*(\d+)$/);if(m){const a=+m[1],b=+m[2];return Array.from({length:Math.max(0,b-a+1)},(_,i)=>a+i)}return +x?[+x]:[]});
let tt;function toast(m){const t=$("#ts");t.textContent=m;t.classList.add("show");clearTimeout(tt);tt=setTimeout(()=>t.classList.remove("show"),2800)}
function openMd(title,html,fn){mdFn=fn||null;$("#md").innerHTML=`<div class="mp"><div class="row noprint"><h3>${title}</h3><button class="x" data-a="close" aria-label="Close">✕</button></div>${html}</div>`;$("#md").classList.add("show")}
function closeMd(){mdFn=null;$("#md").classList.remove("show")}
const badge=s=>`<span class="bg ${s}">${SL[s]}</span>`,payB=o=>o.paid?`<span class="bg served">Paid${o.pm&&o.pm!="cash"?" (demo)":""}</span>`:`<span class="bg pending">Payment pending</span>`;
const demoB=o=>o.demo?' <span class="bg demo">SAMPLE</span>':"";

/* ---------- customer ---------- */
function dishCard(i){const q=cart[i.id]||0;
 return`<div class="card dish ${i.on?"":"off"}"><div class="plate">${i.img?`<img src="${i.img}" alt="${esc(i.n)}">`:`<span class="em">${i.e}</span>`}</div><div class="in"><div class="nm"><i class="vg ${i.v?"":"nv"}" title="${i.v?"Veg":"Non-veg"}"></i>${esc(i.n)}${i.t?`<span class="tg">★ ${esc(i.t)}</span>`:""}</div><div class="ds">${esc(i.d)}</div>
 <div class="row"><span class="pr">${fmt(i.p)}</span>${!i.on?'<span class="bg cancelled">Unavailable</span>':q?`<div class="qty"><button data-a="dec" data-id="${i.id}" aria-label="Less">−</button><b>${q}</b><button data-a="inc" data-id="${i.id}" aria-label="More">+</button></div>`:`<button class="btn sm" data-a="inc" data-id="${i.id}">ADD +</button>`}</div></div></div>`}
function menuHtml(){const f=S.menu.filter(i=>(cat=="All"||i.c==cat)&&(!veg||i.v)&&(i.n+" "+i.d).toLowerCase().includes(qs.toLowerCase()));
 if(!f.length)return'<div class="empty">No dishes match your search.</div>';
 return CATS.concat([...new Set(S.menu.map(i=>i.c))].filter(c=>!CATS.includes(c))).filter(c=>f.some(i=>i.c==c)).map(c=>`<div class="sec">${esc(c)}</div><div class="grid">${f.filter(i=>i.c==c).map(dishCard).join("")}</div>`).join("")}
function barHtml(){const n=cnt();return n?`<div class="bar"><button class="btn" data-a="cart"><span>🛒 ${n} item${n>1?"s":""} · View cart</span><span>${fmt(calc(cartItems()).sub)}</span></button></div>`:""}
function renderCust(){const cs=["All",...new Set(S.menu.map(i=>i.c))];
 $("#app").innerHTML=`${welcomed?"":`<div class="splash"><div class="mono" style="width:70px;height:70px;font-size:36px">R</div><h1>${esc(S.cfg.name).toUpperCase()}</h1><p class="mu" style="letter-spacing:5px;font-size:12px">FINE INDIAN DINING</p><span class="pill">Table ${table}</span><p class="mu" style="max-width:300px">Browse the menu, order from your seat and track your food live.</p><button class="btn" data-a="start" style="padding:14px 34px;margin-top:10px">View menu</button></div>`}
 <header class="hero"><div class="mono">R</div><h1>${esc(S.cfg.name).toUpperCase()}</h1><p>Fine Indian Dining</p><span class="pill">🪑 Table ${table}</span>
 <div class="row" style="justify-content:center;margin-top:14px;flex-wrap:wrap"><button class="chip" data-a="orders">📋 My orders</button><button class="chip" data-a="waiter">🔔 Call waiter</button></div></header>
 <main class="wrap"><div class="row" style="gap:10px"><input id="srch" type="search" placeholder="Search dishes…" value="${esc(qs)}" aria-label="Search"><button class="chip ${veg?"on":""}" data-a="veg" style="flex:none">🌿 Veg only</button></div>
 <div class="scroll">${cs.map(c=>`<button class="chip ${cat==c?"on":""}" data-a="cat" data-v="${esc(c)}">${esc(c)}</button>`).join("")}</div>
 <div id="menuArea">${menuHtml()}</div>
 <p class="mu" style="text-align:center;margin-top:30px;font-size:12px">Prices exclude GST (${S.cfg.gst}%). Payments in this version are a demo.<br><a href="#owner" style="color:var(--gold)">Owner</a> · <a href="#kitchen" style="color:var(--gold)">Kitchen</a> · <a href="#staff" style="color:var(--gold)">Staff</a></p></main><div id="barArea">${barHtml()}</div>`;
 $("#srch").oninput=e=>{qs=e.target.value;$("#menuArea").innerHTML=menuHtml()}}
function cartModal(){const its=cartItems();
