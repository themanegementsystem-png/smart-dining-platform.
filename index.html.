let AC;const unlock=()=>{try{AC=AC||new(window.AudioContext||window.webkitAudioContext)();if(AC.state=="suspended")AC.resume()}catch(e){}};
document.addEventListener("pointerdown",unlock);
function tone(f,t,d,v=.18){const o=AC.createOscillator(),g=AC.createGain(),s=AC.currentTime+t;o.type="sine";o.frequency.value=f;o.connect(g);g.connect(AC.destination);g.gain.setValueAtTime(.0001,s);g.gain.exponentialRampToValueAtTime(v,s+.02);g.gain.exponentialRampToValueAtTime(.0001,s+d);o.start(s);o.stop(s+d+.05)}
function chime(k){unlock();if(!AC)return;try{({order:()=>[[784,0],[1047,.16],[1319,.32],[1047,.65],[1319,.81]].forEach(([f,t])=>{tone(f,t,.5);tone(f*2,t,.3,.04)}),call:()=>[0,.3,.6].forEach(t=>{tone(1568,t,.4,.2);tone(2093,t,.3,.05)}),pay:()=>[523,659,784,1047,1319].forEach((f,i)=>{tone(f,i*.09,.5,.16);tone(f*2,i*.09,.2,.04)}),ready:()=>[659,880,1109].forEach((f,i)=>tone(f,i*.14,.5,.15))}[k])();navigator.vibrate&&navigator.vibrate([120,60,120])}catch(e){}}
function ping(k,m){toast(m);if(k)chime(k);try{if(document.hidden&&Notification.permission=="granted")new Notification(S.cfg.name,{body:m})}catch(e){}}
function notify(o,n){const ids=new Set(o.orders.map(x=>x.no)),mine=t=>(n.staff.find(s=>s.id==stf)||n.staff[0]||{tables:[]}).tables.includes(t);
