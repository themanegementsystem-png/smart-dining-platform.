 if(view=="staff"||view=="owner")n.calls.filter(c=>!o.calls.some(d=>d.table==c.table&&d.ts==c.ts)).forEach(c=>{if(view=="owner"||mine(c.table))ping("call","🔔 Table "+c.table+" is calling the waiter")});
 n.orders.forEach(x=>{const p=o.orders.find(d=>d.no==x.no);if(!p||x.demo)return;
  if(view=="owner"&&x.paid&&!p.paid)ping("pay","💰 Table "+x.table+" paid "+fmt(x.tot)+(x.pm!="cash"?" (demo)":""));
  if(view=="staff"&&x.status=="ready"&&p.status!="ready"&&mine(x.table))ping("ready","✅ Order #"+x.no+" is ready · Table "+x.table);
  if(view=="cust"&&x.table==table&&x.status!=p.status)ping(x.status=="ready"?"ready":"","Order #"+x.no+": "+SL[x.status])})}
function confetti(){const f=document.createElement("div");f.style.cssText="position:fixed;inset:0;pointer-events:none;z-index:95;overflow:hidden";f.innerHTML=Array.from({length:26},(_,i)=>`<span style="position:absolute;left:${Math.random()*100}%;top:-30px;font-size:${18+Math.random()*16}px;animation:fall ${1.6+Math.random()*1.4}s ${Math.random()*.4}s ease-in forwards">${["✨","🌟","👑","🪙"][i%4]}</span>`).join("");document.body.appendChild(f);setTimeout(()=>f.remove(),3500)}
